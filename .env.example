DATABASE_URL=postgresql+asyncpg://orchestration:orchestration@localhost:5432/orchestration
REDIS_URL=redis://localhost:6379/0
TASK_SOURCE_TYPE=csv
REVIEW_SURFACE_TYPE=web_ui
API_KEY_HEADER=X-API-Key
DEFAULT_REVIEW_TIMEOUT_SECONDS=86400
DEFAULT_MONTHLY_BUDGET_USD=500
WORKTREE_BASE_PATH=/var/worktrees
WORKTREE_TTL_DAYS=30
LOG_LEVEL=INFO

# LLM provider — Anthropic-compatible or OpenAI-compatible endpoint.
# Read by src/orchestration/llm/* and the orchestrator flow.
# Protocol: "anthropic" or "openai". Endpoint URL is the API root (no /v1 suffix).
# IMPORTANT: real key lives in .env (gitignored); never commit LLM_API_KEY.
LLM_PROTOCOL=anthropic
LLM_ENDPOINT_URL=https://api.minimax.io/anthropic
LLM_API_KEY=sk-replace-me
LLM_MODEL=claude-sonnet-4-5
